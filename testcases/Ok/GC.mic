module GC [level=4]
import BI := Box(integer)
import II := Iter(integer)

type Sum = object(II.ForEach) total: integer end

procedure Sum.apply(const e: ^integer)
begin 
  self.total := self.total + e^ 
end apply

var s: ^Sum
    b: BI.BoxPtr
    f: II.ForEachPtr
    i: integer
begin
  new(s) new(b)
  for i := 1 to 5 do b.append(@i) end
  f := s
  b.forEach(f)
  println(s.total)
end GC
