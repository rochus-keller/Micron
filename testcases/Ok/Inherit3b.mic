module Inherit3b [level=4]

type
  A = object end
  APtr = pointer to A
  B = object(A) end
  BPtr = pointer to B
  C = object(B) end
  CPtr = pointer to C

procedure A.name(): integer
begin
  return 1
end name

procedure B.name(): integer
begin
  return 2
end name

procedure C.name(): integer
begin
  return 3
end name

var a: APtr; b: BPtr; c: CPtr
begin
  new(b); new(c)
  a := b
  println(a.name())
  a := c
  println(a.name())
end Inherit3b
