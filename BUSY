if busy_version < "2023-01-15" {
    error("this version of BUSY is not compatible with this build")
}

let mtconf : Config {
    .cflags = [ "/O2", "/MT" ]
}

if (build_mode == `optimized) && (target_toolchain == `msvc) {
    set_defaults(target_toolchain,mtconf)
}

submod qtmini = ../LeanQt (HAVE_FILEIO, HAVE_COREAPP, HAVE_CMDLINE)

let config : Config {
    .configs += [ qtmini.core_client_config ]
    .include_dirs += ..
    if build_mode == `debug {
        .defines += "_DEBUG"
    }
}

let utils : SourceSet {
    .configs += config;
    .sources += [
        ./MicRowCol.cpp
        ./MicAtom.cpp
        ./MilOps.cpp
        ./MicRowCol.h
        ./MicAtoms.h
        ./MilOps.h
    ]
}

